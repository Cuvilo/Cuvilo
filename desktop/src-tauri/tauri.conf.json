{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuvilo",
  "version": "0.1.51",
  "identifier": "local.interview.copilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cuvilo",
        "width": 940,
        "height": 640,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "theme": "Light",
        "visible": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "实时会议转写与面试参考答案",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMEJDMTBGMjk3QzhGNDIKUldSQ2ozd3BEOEVMa3JPbkY0MHJvVFVXcytsL1cwdFZ0NWU5QkRtaDd2cVpKWUp2SEh6VDNyMmgK",
      "endpoints": [
        "https://github.com/Cuvilo/Cuvilo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
